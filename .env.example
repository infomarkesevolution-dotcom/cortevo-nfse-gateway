# variaveis do gateway
PORT=8080

# chave que o app envia no header x-api-key (gere uma string longa)
GATEWAY_API_KEY=troque-esta-chave

# restrita = homologacao (producaorestrita) | producao = ambiente real
NFSE_AMBIENTE=restrita

# opcional: sobrescreve a base da Sefin
# NFSE_BASE_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional

# onde os .pfx ficam guardados (volume persistente)
CERT_DIR=./certs
